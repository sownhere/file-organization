#!/bin/bash
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
ensure_script="${repo_root}/scripts/ensure-swift-header.sh"

staged_files=()
while IFS= read -r file_path; do
  [[ -z "${file_path}" ]] && continue
  [[ "${file_path}" != *.swift ]] && continue
  staged_files+=("${repo_root}/${file_path}")
done < <(git diff --cached --name-only --diff-filter=ACMR)

if [[ "${#staged_files[@]}" -eq 0 ]]; then
  exit 0
fi

"${ensure_script}" "${staged_files[@]}"

for file_path in "${staged_files[@]}"; do
  git add "${file_path}"
done
